	)
	(text "GPIO-Belegung: erster Vorschlag\n(R-04 §10, angepasst an Versorgungskonzept B).\nAnalog nur ADC1 (IO1–IO10),\nWeck-Taster auf RTC-GPIOs.\nGlobale Labels = Signale zu anderen Blättern."
		(exclude_from_sim no)
		(at 314.96 140.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
