	)
	(text "Pull-downs 10 kΩ = Default AUS (MOT_EN, BRUSH_EN).\nIO45 ist Strapping-Pin: Pull-down Pflicht,\nnichts darf hochziehen!\nStatus-LEDs D23/D28 (Blatt Motor) hängen\nmit 1 kΩ gegen GND an MOT_EN/BRUSH_EN. IO46 (Strapping) bleibt frei."
		(exclude_from_sim no)
		(at 165.1 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
