	)
	(text "V_LOGIC: V_MOT fest an Pin 5 (nur mit MOT_EN, 0,25–0,31 A über U62).\nKeine ESC-Versorgung (BEC) an Pin 5 anschließen – kein Rückspeiseschutz!\nGND: R617 10 Ω begrenzt den Ausgleichsstrom über die dünne\nSignalader (Option 0 Ω). Board-seitig nahe der Klemme MOTOR− anbinden.\nESD direkt an J61: SD36C (TX D65, RX, TACHO, V_LOGIC), U83 (NTC)."
		(exclude_from_sim no)
		(at 15.24 215.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
